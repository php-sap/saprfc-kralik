parameters:
  level: 9
  paths:
    - src/
    - tests/
  scanDirectories:
    - vendor/
  ignoreErrors:
    - '/PHPDoc tag @var above a method has no effect\./'
    -
      # The mocked module stub used for static analysis never declares a
      # TypeError, but the real sapnwrfc extension can throw it for
      # malformed invoke() parameters, so this catch is intentional.
      message: '/Dead catch - TypeError is never thrown in the try block\./'
      path: src/SapRfc.php
      count: 1
    -
      # tests/helper/SAPNWRFC.php is a verbatim copy of the real extension's
      # stub file (see its header comment) and must not diverge from it with
      # generic array type annotations, so its missing iterable value types
      # are intentionally left unaddressed.
      message: '/value type specified in iterable type array\./'
      path: tests/helper/SAPNWRFC.php
